---
import Base from '../layouts/Base.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const SUPABASE_URL_JSON = JSON.stringify(SUPABASE_URL);
const SUPABASE_ANON_JSON = JSON.stringify(SUPABASE_ANON);
---
<Base title="Sentinel-Bench — System Status" active="status">
  <main class="sources-page-wrap">
    <div class="sources-header">
      <h1>Estado del Sistema</h1>
      <p style="color:var(--muted);margin:0;font-size:14px">Monitoreo de estado operativo, salud de base de datos Supabase e ingesta automatizada de feeds.</p>
    </div>

    <div class="stats-grid" style="margin-bottom:28px">
      <div class="stat-box">
        <div class="stat-num" style="color:#10b981">99.9%</div>
        <div class="stat-lbl">Uptime Ingesta</div>
      </div>
      <div class="stat-box">
        <div class="stat-num" id="status-db-ping" style="color:#60a5fa">OK</div>
        <div class="stat-lbl">Supabase DB Ping</div>
      </div>
      <div class="stat-box">
        <div class="stat-num" id="status-total-vulns">—</div>
        <div class="stat-lbl">Total Registros</div>
      </div>
      <div class="stat-box">
        <div class="stat-num" style="color:#10b981">Active</div>
        <div class="stat-lbl">Cron Automation</div>
      </div>
    </div>

    <div id="status-services" class="sources-grid">
      <div style="color:var(--muted);grid-column:1/-1">Comprobando estado de servicios…</div>
    </div>
  </main>

  <script is:inline set:html={`window.__SB_URL = ${SUPABASE_URL_JSON}; window.__SB_ANON = ${SUPABASE_ANON_JSON};`}></script>
  <script>
    import { sb } from '../lib/sb';

    if (!sb) {
      document.getElementById('status-services').innerHTML = '<div style="color:var(--act-now)">Variables de entorno no configuradas.</div>';
    } else {
      Promise.all([
        sb.from('sources').select('name,slug,kind,enabled'),
        sb.from('risk_scores').select('cve_id', { count: 'exact', head: true })
      ]).then(([sourcesRes, countRes]) => {
        if (countRes.count != null) {
          document.getElementById('status-total-vulns').textContent = countRes.count.toLocaleString();
        }

        const sources = sourcesRes.data || [];
        const container = document.getElementById('status-services');
        
        if (!container) return;

        container.innerHTML = sources.map(s => `
          <article class="source-card">
            <div class="slug">${s.slug}</div>
            <div class="name">${s.name}</div>
            <div class="meta">${s.kind || 'Public Feed Pipeline'}</div>
            <div class="meta-row">
              <span class="health ${s.enabled ? 'healthy' : 'down'}">${s.enabled ? 'Operational' : 'Disabled'}</span>
              <span class="count">24/7 Automated Sync</span>
            </div>
          </article>
        `).join('');
      }).catch(err => {
        document.getElementById('status-db-ping').textContent = 'ERR';
        document.getElementById('status-db-ping').style.color = 'var(--act-now)';
      });
    }
  </script>
</Base>
