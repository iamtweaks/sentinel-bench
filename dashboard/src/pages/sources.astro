---
import Base from '../layouts/Base.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<Base title="Sentinel-Bench — Fuentes">
  <h1>Fuentes de Inteligencia</h1>
  <p style="color:var(--muted)">Catálogo de feeds públicos consumidos por Sentinel-Bench. Solo se ingiere contenido legítimo y abierto.</p>
  <div id="src-grid" class="sources-list">
    <p style="color:var(--muted)">Cargando…</p>
  </div>
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON }}>
    window.__SB_URL = SUPABASE_URL;
    window.__SB_ANON = SUPABASE_ANON;
  </script>
  <script>
    import { sb } from '../lib/sb';

    function esc(s: string): string {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
    }

    if (!sb) {
      const el = document.getElementById('src-grid');
      if (el) el.innerHTML = '<p style="color:var(--crit)">Faltan env vars de Supabase.</p>';
    } else {
      // Single query with embedded count — avoids PostgREST default 1000-row limit.
      sb.from('sources')
        .select('id,slug,name,kind,url,enabled,advisories(count)')
        .order('slug')
        .then(({ data, error }) => {
          const grid = document.getElementById('src-grid');
          if (!grid) return;
          if (error) { grid.innerHTML = `<p style="color:var(--crit)">${esc(error.message)}</p>`; return; }
          grid.innerHTML = (data || []).map((s) => {
            const c = (s.advisories && s.advisories[0] && s.advisories[0].count) || 0;
            return `<div class="source-card">
              <div class="slug">${esc(s.slug)}</div>
              <div style="font-size:14px;margin-top:6px">${esc(s.name)}</div>
              <div class="meta">${esc(s.kind)} · ${s.enabled ? 'enabled' : 'disabled'} · ${c.toLocaleString()} advisories</div>
              <div class="meta">${s.url ? `<a href="${s.url}" target="_blank" rel="noopener">URL oficial ↗</a>` : ''}</div>
            </div>`;
          }).join('');
        });
    }
  </script>
</Base>