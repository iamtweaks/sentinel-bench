---
import Base from '../layouts/Base.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const SUPABASE_URL_JSON = JSON.stringify(SUPABASE_URL);
const SUPABASE_ANON_JSON = JSON.stringify(SUPABASE_ANON);
---
<Base title="Sentinel-Bench — Fuentes" active="sources">
  <h1>Fuentes de Inteligencia</h1>
  <p style="color:var(--muted);margin-bottom:24px">Catálogo de feeds públicos consumidos por Sentinel-Bench. Solo se ingiere contenido legítimo y abierto.</p>
  <div id="src-grid" class="sources-grid">
    <p style="color:var(--muted)">Cargando…</p>
  </div>
  <script is:inline set:html={`window.__SB_URL = ${SUPABASE_URL_JSON}; window.__SB_ANON = ${SUPABASE_ANON_JSON};`}></script>
  <script>
    import { sb } from '../lib/sb';

    function esc(s: string): string {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
    }

    function healthFor(published: string | null, enabled: boolean): { cls: string; label: string } {
      if (!enabled) return { cls: 'down', label: 'Disabled' };
      if (!published) return { cls: 'stale', label: 'Sin datos' };
      const ageMs = Date.now() - new Date(published).getTime();
      const days = ageMs / (1000 * 60 * 60 * 24);
      // ponytail: 14d threshold for "stale" is heuristic — refine if sources show false-negatives.
      if (days > 14) return { cls: 'down', label: 'Stale' };
      if (days > 7) return { cls: 'stale', label: 'Older' };
      return { cls: 'healthy', label: 'Healthy' };
    }

    function fmtWhen(iso: string | null): string {
      if (!iso) return '—';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '—';
      return d.toISOString().slice(0, 10);
    }

    if (!sb) {
      const el = document.getElementById('src-grid');
      if (el) el.innerHTML = '<p style="color:var(--crit)">Faltan env vars de Supabase.</p>';
    } else {
      sb.from('sources')
        .select('id,slug,name,kind,url,enabled,advisories(published_at,count)')
        .order('slug')
        .then(({ data, error }) => {
          const grid = document.getElementById('src-grid');
          if (!grid) return;
          if (error) { grid.innerHTML = `<p style="color:var(--crit)">${esc(error.message)}</p>`; return; }
          grid.innerHTML = (data || []).map((s, i) => {
            const count = (s.advisories && s.advisories[0] && s.advisories[0].count) || 0;
            const lastPublished = (s.advisories && s.advisories[0] && s.advisories[0].published_at) || null;
            const h = healthFor(lastPublished, s.enabled);
            return `<div class="source-card" style="--delay:${Math.min(i, 24) * 30}ms">
              <div class="slug">${esc(s.slug)}</div>
              <div class="name">${esc(s.name)}</div>
              <div class="meta">${esc(s.kind)} · last seen ${fmtWhen(lastPublished)}</div>
              <div class="meta-row">
                <span class="health ${h.cls}">${h.label}</span>
                <span class="count">${count.toLocaleString()} advisories</span>
              </div>
              ${s.url ? `<div class="meta"><a href="${esc(s.url)}" target="_blank" rel="noopener">URL oficial ↗</a></div>` : ''}
            </div>`;
          }).join('');
        });
    }
  </script>
</Base>
