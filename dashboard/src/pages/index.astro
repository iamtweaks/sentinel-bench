---
import Base from '../layouts/Base.astro';
---

<Base title="Sentinel-Bench — Personal Cyber Threat Intelligence" active="landing">

  <main class="landing landing-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="tac-bracket tac-label tac-label--accent">
          Personal Cyber Threat Intelligence · REV 2.6
        </div>
        <h1 class="hero-title tac-display">
          Lo que se está<br />
          <span class="hero-accent">rompiendo</span> hoy.
        </h1>
        <p class="hero-sub">
          Sentinel-Bench ingiere CISA KEV, NVD, EPSS, GHSA y MSRC en una sola línea de tiempo priorizada por <em>explotación real</em>, no por score inflado. Tu lista de vendors, tu filtro, tu feed.
        </p>
        <div class="hero-cta">
          <a href="/dashboard/" class="btn-primary">[ ABRIR DASHBOARD &gt;&gt; ]</a>
          <a href="/sources/" class="btn-secondary">VER FUENTES ///</a>
        </div>
        <hr class="tac-rule" />
        <div class="hero-meta">
          <span><strong class="hero-stat">005</strong><span class="tac-label">FUENTES</span></span>
          <span class="dot"></span>
          <span><strong class="hero-stat">030<span class="hero-stat-unit">MIN</span></strong><span class="tac-label">CADENCIA</span></span>
          <span class="dot"></span>
          <span><strong class="hero-stat">100<span class="hero-stat-unit">%</span></strong><span class="tac-label">OPEN SOURCE</span></span>
          <span class="dot"></span>
          <span class="status-live"><span class="status-dot"></span><span class="tac-label tac-label--phosphor">LIVE FEED</span></span>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats">
      <div class="stat">
        <div class="stat-num">5</div>
        <div class="stat-label"><span class="tac-label">FUENTES OFICIALES</span><small>CISA KEV · NVD · EPSS · GHSA · MSRC</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">30<span class="stat-unit">M</span></div>
        <div class="stat-label"><span class="tac-label">CADENCIA INGESTIÓN</span><small>KEV + GHSA cada 30 min</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">4</div>
        <div class="stat-label"><span class="tac-label">CAPAS DE FILTRADO</span><small>vendor · dominio · urgencia · severidad</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">0</div>
        <div class="stat-label"><span class="tac-label">TELEMETRÍA SALIENTE</span><small>sin trackers · sin analytics · sin cookies</small></div>
      </div>
    </section>

    <!-- CÓMO SE VE -->
    <section class="features">
      <div class="section-eyebrow tac-label tac-label--accent">/// SECCIÓN 01 — INTERFAZ</div>
      <h2 class="section-title tac-display">Tres pantallas.<br />Una decisión.</h2>
      <div class="feature-grid">
        <article class="feature">
          <div class="feature-num">// 01</div>
          <h3>Feed priorizado por explotación real</h3>
          <p>No es una lista de CVEs. Es una lista de cosas que <em>alguien</em> confirmó que se están rompiendo en este momento. Filtrá por dominio (IT / OT), urgencia (Act Now / Plan Patch / Monitor / Low Risk) y severidad.</p>
        </article>
        <article class="feature">
          <div class="feature-num">// 02</div>
          <h3>Tus vendors primero</h3>
          <p>Seleccionás qué fabricantes te importan (Cisco, Microsoft, Apache, lo que uses). El feed colapsa el ruido. Sin scroll infinito, sin 2000 vulns irrelevantes sobre productos que no corrés.</p>
        </article>
        <article class="feature">
          <div class="feature-num">// 03</div>
          <h3>KEV en un click</h3>
          <p>El catálogo CISA KEV integrado — la lista corta de "explotado en la calle, tenés que patchear". Toggle de un botón. Lo que aparece en rojo es lo que ya está quemando plata afuera.</p>
        </article>
      </div>
    </section>

    <!-- POR QUÉ IMPORTA -->
    <section class="why">
      <div class="why-grid">
        <div class="why-copy">
          <div class="section-eyebrow tac-label tac-label--accent">/// SECCIÓN 02 — MOTIVACIÓN</div>
          <h2 class="section-title tac-display">El feed público es ruido.</h2>
          <p>
            NVD te tira <strong>40.000 CVEs por año</strong>. Menos del 4% tiene exploit público conocido. Menos del 1% está siendo activamente explotado. Sentinel-Bench corta el 96% que no necesitás ver y deja lo que tenés que mirar esta semana.
          </p>
          <p>
            No es un panel lindo — es una herramienta operativa. Para el CISO que patchea los martes y el pentester que necesita qué probar esta semana.
          </p>
        </div>
        <aside class="why-side">
          <div class="why-stat">
            <div class="why-stat-num">~03<span class="why-stat-unit">%</span></div>
            <div class="why-stat-label"><span class="tac-label">EXPLOIT PÚBLICO</span><div class="why-stat-text">de los CVEs publicados tienen exploit público conocido</div></div>
          </div>
          <div class="why-stat">
            <div class="why-stat-num">~0.4<span class="why-stat-unit">%</span></div>
            <div class="why-stat-label"><span class="tac-label">EN KEV</span><div class="why-stat-text">están en CISA KEV (explotados activamente en la calle)</div></div>
          </div>
          <div class="why-stat">
            <div class="why-stat-num">05<span class="why-stat-unit">M</span></div>
            <div class="why-stat-label"><span class="tac-label">TIEMPO DE DECISIÓN</span><div class="why-stat-text">es lo que tarda abrir el feed y decidir qué patchear</div></div>
          </div>
        </aside>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <div class="cta-inner">
        <div class="section-eyebrow tac-label tac-label--phosphor">&gt;&gt;&gt; END OF LINE</div>
        <h2 class="tac-display">Probalo en<br />30 segundos.</h2>
        <p>Sin signup. Sin cookie. Sin waitlist. El dashboard está abierto.</p>
        <div class="cta-buttons">
          <a href="/dashboard/" class="btn-primary">[ ABRIR DASHBOARD &gt;&gt; ]</a>
          <a href="https://github.com/iamtweaks/sentinel-bench" rel="noopener" target="_blank" class="btn-secondary">GITHUB /// REPO</a>
        </div>
        <hr class="tac-rule" />
        <div class="cta-foot tac-label">
          BUILD 2026.08 · UNIT D-01 · MIT LICENSE · NO ANALYTICS
        </div>
      </div>
    </section>

  </main>

  <style>
    .landing {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 10;
    }

    /* HERO */
    .hero { padding: 88px 0 56px; }
    .hero-inner { max-width: 920px; }
    .hero-title {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2.8rem, 7vw, 5.6rem);
      line-height: 0.92;
      font-weight: 900;
      letter-spacing: -0.045em;
      color: var(--text);
      text-transform: uppercase;
      margin: 20px 0 28px;
    }
    .hero-accent {
      color: var(--accent);
      text-shadow: 0 0 22px var(--accent-glow);
    }
    .hero-sub {
      font-size: 16px;
      line-height: 1.65;
      color: var(--text-dim);
      max-width: 680px;
      margin: 0 0 32px;
      border-left: 2px solid var(--accent);
      padding: 4px 0 4px 18px;
    }
    .hero-sub em {
      color: var(--text);
      font-style: normal;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin-bottom: 32px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 14px 22px;
      background: var(--accent);
      color: var(--text);
      border: 1px solid var(--accent);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 12.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.12s ease;
    }
    .btn-primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 14px 22px;
      background: transparent;
      color: var(--text);
      border: 1px solid var(--text);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 12.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.12s ease;
    }
    .btn-secondary:hover {
      background: var(--text);
      color: var(--bg);
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: 12px;
      color: var(--muted);
      flex-wrap: wrap;
      padding-top: 18px;
    }
    .hero-meta > span {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
    }
    .hero-stat {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 18px;
      color: var(--text);
      letter-spacing: 0.02em;
    }
    .hero-stat-unit {
      font-size: 11px;
      color: var(--accent);
      margin-left: 2px;
      font-weight: 600;
    }
    .hero-meta .dot {
      width: 1px; height: 14px;
      background: var(--border-2);
    }
    .status-live {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .status-dot {
      width: 8px; height: 8px;
      background: var(--phosphor);
      box-shadow: 0 0 8px var(--phosphor);
      animation: blink 1.4s steps(2, end) infinite;
    }
    @keyframes blink {
      50% { opacity: 0.25; }
    }

    /* STATS — grid de paneles con 1px dividers */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      padding: 0;
      margin: 24px 0 64px;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .stat {
      padding: 24px 22px;
      background: var(--bg);
      border-right: 1px solid var(--border-2);
    }
    .stat:last-child { border-right: none; }
    .stat-num {
      font-family: var(--font-mono);
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      color: var(--accent);
      letter-spacing: -0.04em;
      margin-bottom: 14px;
      text-shadow: 0 0 24px var(--accent-glow);
    }
    .stat-unit {
      font-size: 18px;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .stat-label {
      font-size: 12.5px;
      color: var(--text-dim);
      line-height: 1.5;
    }
    .stat-label small {
      display: block;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      margin-top: 6px;
    }

    /* SECTION GENERIC */
    .section-eyebrow {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .section-title {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2rem, 4.4vw, 3.4rem);
      line-height: 0.92;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text);
      text-transform: uppercase;
      margin: 0 0 40px;
      max-width: 720px;
    }

    /* FEATURES — bordes rectos, numeración industrial */
    .features { padding: 24px 0 64px; }
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .feature {
      background: var(--bg);
      padding: 26px 22px 22px;
      border-right: 1px solid var(--border-2);
      transition: background 0.12s ease;
    }
    .feature:last-child { border-right: none; }
    .feature:hover {
      background: var(--panel);
    }
    .feature-num {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent);
      letter-spacing: 0.12em;
      margin-bottom: 16px;
    }
    .feature h3 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      margin: 0 0 14px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }
    .feature p {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-dim);
      margin: 0;
    }
    .feature p em {
      color: var(--text);
      font-style: normal;
      font-weight: 700;
    }

    /* WHY */
    .why { padding: 56px 0 80px; border-top: 1px solid var(--border-2); }
    .why-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 0;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .why-copy {
      background: var(--bg);
      padding: 28px 26px;
      border-right: 1px solid var(--border-2);
    }
    .why-copy p {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-dim);
      margin: 0 0 16px;
    }
    .why-copy p strong {
      color: var(--text);
      font-weight: 700;
    }
    .why-side {
      background: var(--bg);
      padding: 0;
    }
    .why-stat {
      padding: 22px 24px;
      border-bottom: 1px solid var(--border-2);
    }
    .why-stat:last-child { border-bottom: none; }
    .why-stat-num {
      font-family: var(--font-mono);
      font-size: 36px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 14px;
      text-shadow: 0 0 18px var(--accent-glow);
    }
    .why-stat-unit {
      font-size: 18px;
      color: var(--text);
      margin-left: 4px;
    }
    .why-stat-label {
      font-size: 12.5px;
      color: var(--text-dim);
      line-height: 1.5;
    }
    .why-stat-text {
      color: var(--text);
      margin-top: 4px;
      font-size: 13px;
    }

    /* CTA FINAL */
    .cta-final {
      padding: 80px 0 96px;
      border-top: 1px solid var(--border-2);
      text-align: center;
    }
    .cta-inner { max-width: 680px; margin: 0 auto; }
    .cta-final h2 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text);
      text-transform: uppercase;
      line-height: 0.92;
      margin: 0 0 18px;
    }
    .cta-final p {
      font-size: 14px;
      color: var(--text-dim);
      margin: 0 0 28px;
    }
    .cta-buttons {
      display: flex;
      gap: 0;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }
    .cta-foot {
      padding-top: 20px;
      text-align: center;
      color: var(--muted);
    }

    /* NAV CTA pill (overrides Base.astro nav) */
    :global(.landing-page) header.nav a.nav-cta {
      color: var(--accent) !important;
      padding: 5px 12px !important;
      font-family: var(--font-mono) !important;
      font-weight: 700 !important;
      font-size: 11px !important;
      letter-spacing: 0.1em !important;
      text-transform: uppercase !important;
      border: 1px solid var(--accent) !important;
      border-radius: 0 !important;
      transition: background 0.12s ease;
    }
    :global(.landing-page) header.nav a.nav-cta:hover {
      background: var(--accent);
      color: var(--text) !important;
    }

    @media (max-width: 880px) {
      .hero { padding: 56px 0 40px; }
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }
      .stat {
        border-right: 1px solid var(--border-2);
        border-bottom: 1px solid var(--border-2);
      }
      .stat:nth-child(2n) { border-right: none; }
      .stat:nth-last-child(-n+2) { border-bottom: none; }
      .feature-grid {
        grid-template-columns: 1fr;
      }
      .feature {
        border-right: none;
        border-bottom: 1px solid var(--border-2);
      }
      .feature:last-child { border-bottom: none; }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-copy {
        border-right: none;
        border-bottom: 1px solid var(--border-2);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .status-dot { animation: none; }
      .btn-primary, .btn-secondary, .feature {
        transition: none;
      }
    }
  </style>

</Base>

