---
import Base from '../layouts/Base.astro';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
// JSON-serialize so define:vars injects string literals, not bare identifiers.
const SUPABASE_URL_JSON = JSON.stringify(SUPABASE_URL);
const SUPABASE_ANON_JSON = JSON.stringify(SUPABASE_ANON);
---
<Base title="Sentinel-Bench — Top Amenazas">
  <h1>Top Amenazas</h1>
  <div class="hero">
    <strong>Cyber Threat Intelligence</strong> personal — vulnerabilidades priorizadas
    por <em>explotación real</em>, no solo CVSS. Combina CISA KEV, EPSS, NVD CVSS, GitHub
    Security Advisories y Microsoft MSRC.
    <p>Top priorizadas por score (KEV + EPSS + CVSS + evidencia de exploit + recencia).
    Buscá y filtrá abajo. Última actualización: <span id="updated">cargando…</span></p>
    <div class="kpis">
      <div class="kpi kev"><div class="v" id="kpi-kev">–</div><div class="l">CVE en CISA KEV</div></div>
      <div class="kpi total"><div class="v" id="kpi-total">–</div><div class="l">Vulnerabilidades</div></div>
      <div class="kpi poc"><div class="v" id="kpi-poc">–</div><div class="l">PoC público</div></div>
      <div class="kpi sources"><div class="v" id="kpi-sources">–</div><div class="l">Fuentes activas</div></div>
    </div>
  </div>

  <div class="filters">
    <input id="q" class="q" type="text" placeholder="Buscar CVE, vendor, producto…" />

    <div class="chip-group" role="radiogroup" aria-label="Dominio">
      <span class="chip-label">Dominio</span>
      <button class="chip is-on" data-domain="" type="button" role="radio" aria-checked="true">Ambos</button>
      <button class="chip chip-it" data-domain="it" type="button" role="radio" aria-checked="false">IT</button>
      <button class="chip chip-ot" data-domain="ot" type="button" role="radio" aria-checked="false">OT</button>
    </div>

    <div class="chip-group" role="radiogroup" aria-label="KEV">
      <span class="chip-label">KEV</span>
      <button class="chip is-on" data-kev="" type="button" role="radio" aria-checked="true">Todos</button>
      <button class="chip chip-act" data-kev="true" type="button" role="radio" aria-checked="false">Solo KEV</button>
      <button class="chip" data-kev="false" type="button" role="radio" aria-checked="false">Sin KEV</button>
    </div>

    <div class="chip-group" role="radiogroup" aria-label="Severidad">
      <span class="chip-label">Severidad</span>
      <button class="chip is-on" data-severity="" type="button" role="radio" aria-checked="true">Todas</button>
      <button class="chip chip-crit" data-severity="CRITICAL" type="button" role="radio" aria-checked="false">Critical</button>
      <button class="chip chip-high" data-severity="HIGH" type="button" role="radio" aria-checked="false">High</button>
      <button class="chip chip-med" data-severity="MEDIUM" type="button" role="radio" aria-checked="false">Medium</button>
      <button class="chip chip-low" data-severity="LOW" type="button" role="radio" aria-checked="false">Low</button>
    </div>

    <div class="chip-group" role="radiogroup" aria-label="Explotación">
      <span class="chip-label">Explotación</span>
      <button class="chip is-on" data-exploit="" type="button" role="radio" aria-checked="true">Todas</button>
      <button class="chip chip-act" data-exploit="confirmed" type="button" role="radio" aria-checked="false">Confirmada</button>
      <button class="chip chip-high" data-exploit="poc" type="button" role="radio" aria-checked="false">PoC</button>
      <button class="chip chip-med" data-exploit="probable" type="button" role="radio" aria-checked="false">Probable</button>
      <button class="chip" data-exploit="unknown" type="button" role="radio" aria-checked="false">Sin evidencia</button>
    </div>

    <label class="toggle"><input type="checkbox" id="sort-score" checked /> Ordenar por score</label>
  </div>

  <section id="it-section">
    <div class="section-head">
      <h2>IT — Vulnerabilidades</h2>
      <span class="meta"><span id="it-count">—</span> resultados</span>
    </div>
    <div id="it-grid" class="cards-grid">
      <div class="empty">Cargando…</div>
    </div>
  </section>

  <div id="detail-pane"></div>

  <section id="ot-section">
    <div class="section-head">
      <h2>OT / ICS — Advisories</h2>
      <span class="meta">Fuentes industriales, vendors, ICS/SCADA y edge de planta</span>
    </div>
    <div id="ot-grid" class="cards-grid">
      <div class="empty">Cargando advisories OT…</div>
    </div>
  </section>

  <script is:inline set:html={`window.__SB_URL = ${SUPABASE_URL_JSON}; window.__SB_ANON = ${SUPABASE_ANON_JSON};`}></script>
  <script>
    import { sb } from '../lib/sb';
    import { renderRows, renderOtCards, bindRowClicks, renderDetail } from '../lib/render';

    if (!sb) {
      document.getElementById('it-grid').innerHTML =
        '<div class="empty" style="color:var(--crit)">Faltan PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY. Configurá las env vars en Vercel.</div>';
    } else {
      const state = {
        rows: [],
        otRows: [],
        sortByScore: true,
        filters: { q: '', kev: '', severity: '', exploit: '', domain: '' },
      };

      const escapeHtml = (v: any = '') => String(v).replace(/[&<>"']/g, (c: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

      async function loadOt() {
        const target = document.getElementById('ot-grid');
        const { data, error } = await sb
          .from('advisories')
          .select('title,summary,url,severity,published_at,vendors,cve_ids')
          .eq('domain', 'OT')
          .order('published_at', { ascending: false, nullsFirst: false })
          .limit(60);
        if (error) {
          target.innerHTML = `<div class="empty">OT no disponible: ${escapeHtml(error.message)}</div>`;
          return;
        }
        if (!data || !data.length) {
          target.innerHTML = '<div class="empty">Todavía no hay advisories OT.</div>';
          return;
        }
        renderOtCards(target, data);
        state.otRows = data;
        applyOtDomainVisibility();
      }

      async function load() {
        const { data: scores, error } = await sb
          .from('risk_scores')
          .select('cve_id, score, factors, rationale, computed_at')
          .order('computed_at', { ascending: false })
          .limit(2000);
        if (error) {
          document.getElementById('it-grid').innerHTML = `<div class="empty" style="color:var(--crit)">Error: ${escapeHtml(error.message)}</div>`;
          return;
        }
        const seen = new Set<string>();
        const top: any[] = [];
        for (const r of scores || []) {
          if (seen.has(r.cve_id)) continue;
          seen.add(r.cve_id);
          top.push(r);
        }
        const cveIds = top.map(r => r.cve_id);
        let vulns: any[] = [];
        if (cveIds.length) {
          const { data } = await sb.from('vulnerabilities').select('cve_id,cvss_v3_score,epss_score,is_kev,vendors,products,exploited_in_wild,poc_public,last_updated_at,description').in('cve_id', cveIds);
          vulns = data || [];
        }
        const vmap = Object.fromEntries(vulns.map((v: any) => [v.cve_id, v]));
        state.rows = top.map(s => ({ ...s, vuln: vmap[s.cve_id] || {} }));

        const kevCount = state.rows.filter(r => r.vuln.is_kev).length;
        const pocCount = state.rows.filter(r => r.vuln.poc_public).length;
        const total = state.rows.length;
        const updated = state.rows[0]?.computed_at;
        document.getElementById('kpi-kev').textContent = kevCount.toLocaleString();
        document.getElementById('kpi-total').textContent = total.toLocaleString();
        document.getElementById('kpi-poc').textContent = pocCount.toLocaleString();
        document.getElementById('kpi-sources').textContent = '5';
        document.getElementById('updated').textContent = updated ? new Date(updated).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : '—';
        sb.from('sources').select('*', { count: 'exact', head: true }).then(({ count }: any) => {
          document.getElementById('kpi-sources').textContent = (count ?? '—').toString();
        });
        render();
      }

      function applyFilters(rows: any[]) {
        const f = state.filters;
        return rows.filter((r: any) => {
          // Domain filter is applied at render time (section visibility) — not here.
          if (f.kev === 'true' && !r.vuln.is_kev) return false;
          if (f.kev === 'false' && r.vuln.is_kev) return false;
          if (f.exploit === 'confirmed' && !r.vuln.exploited_in_wild) return false;
          if (f.exploit === 'poc' && !r.vuln.poc_public) return false;
          if (f.exploit === 'unknown' && (r.vuln.exploited_in_wild || r.vuln.poc_public)) return false;
          if (f.q) {
            const v = ((r.vuln.vendors || []).join(' ')) + ' ' + ((r.vuln.products || []).join(' ')) + ' ' + r.cve_id;
            if (!v.toLowerCase().includes(f.q.toLowerCase())) return false;
          }
          if (f.severity) {
            const cvss = r.vuln.cvss_v3_score;
            if (f.severity === 'CRITICAL' && !(cvss >= 9)) return false;
            if (f.severity === 'HIGH' && !(cvss >= 7 && cvss < 9)) return false;
            if (f.severity === 'MEDIUM' && !(cvss >= 4 && cvss < 7)) return false;
            if (f.severity === 'LOW' && !(cvss !== null && cvss < 4)) return false;
          }
          return true;
        });
      }

      function applyOtDomainVisibility() {
        const ot = document.getElementById('ot-section') as HTMLElement | null;
        const grid = document.getElementById('ot-grid');
        if (!ot || !grid) return;
        if (state.filters.domain === 'it') {
          ot.style.display = 'none';
        } else {
          ot.style.display = '';
        }
      }

      function setActive(group: Element, btn: HTMLElement) {
        group.querySelectorAll<HTMLElement>('.chip').forEach(c => {
          c.classList.remove('is-on');
          c.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-on');
        btn.setAttribute('aria-checked', 'true');
      }

      function wireChipGroup(name: 'domain' | 'kev' | 'severity' | 'exploit') {
        const group = document.querySelector(`.chip-group + .chip-group[data-name="${name}"], .chip-group[data-name="${name}"]`);
        // Fallback: find group by data attribute (set below).
        const target = group || document.querySelector(`[data-name="${name}"]`);
        if (!target) return;
        target.querySelectorAll<HTMLButtonElement>('button.chip').forEach(btn => {
          btn.addEventListener('click', () => {
            const value = btn.dataset[name] ?? '';
            (state.filters as any)[name] = value;
            setActive(target, btn);
            if (name === 'domain') applyOtDomainVisibility();
            render();
          });
        });
      }

      // Tag the chip-groups so wireChipGroup can find them.
      document.querySelectorAll('.chip-group').forEach(g => {
        const label = g.getAttribute('aria-label')?.toLowerCase();
        if (label === 'dominio') g.setAttribute('data-name', 'domain');
        else if (label === 'kev') g.setAttribute('data-name', 'kev');
        else if (label === 'severidad') g.setAttribute('data-name', 'severity');
        else if (label === 'explotación') g.setAttribute('data-name', 'exploit');
      });
      wireChipGroup('domain');
      wireChipGroup('kev');
      wireChipGroup('severity');
      wireChipGroup('exploit');

      function render() {
        let rows = applyFilters(state.rows);
        if (state.sortByScore) rows.sort((a: any, b: any) => b.score - a.score);
        const grid = document.getElementById('it-grid');
        // IT section visibility (depends on whether we're hiding IT for OT-only)
        const itSection = document.getElementById('it-section') as HTMLElement | null;
        if (itSection) itSection.style.display = state.filters.domain === 'ot' ? 'none' : '';
        renderRows(grid, rows);
        document.getElementById('it-count').textContent = rows.length.toLocaleString();
        bindRowClicks(grid, (cve: string) => {
          const detail = state.rows.find((r: any) => r.cve_id === cve);
          renderDetail(document.getElementById('detail-pane'), detail);
        });
      }

      document.getElementById('q').addEventListener('input', e => { state.filters.q = (e.target as HTMLInputElement).value; render(); });
      document.getElementById('sort-score').addEventListener('change', e => { state.sortByScore = (e.target as HTMLInputElement).checked; render(); });

      load();
      loadOt();
    }
  </script>
</Base>
